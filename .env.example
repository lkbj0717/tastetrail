# Server-only settings. Copy to .env; do not commit real values.
# Using a mounted credential JSON is preferred. Its supported keys are documented
# in docs/DEPLOYMENT.md. Empty environment API keys override JSON keys, so no
# QLOO_API_KEY or GLM_API_KEY placeholders are exported here.
TASTETRAIL_CREDENTIALS=/run/secrets/tastetrail.json
V11_PRIVATE=/data/culture_v11
V13_PRIVATE=/data/culture_v13
TASTETRAIL_PRIVATE_DIR=/data
TASTETRAIL_MODEL_PROVIDER=glm
GLM_BASE_URL=https://openclaw-v2.top/llm/v1
GLM_MODEL=glm-5.3-flash

# Set a long random shared secret for a server-to-server proxy. Keep the same
# value in the proxy's secret store; never place it in frontend JavaScript.
TASTETRAIL_GATEWAY_TOKEN=
# Optional direct browser access: exact public frontend origin(s), separated by
# commas, for example https://your-demo.example.com. No wildcard is accepted.
# Leave the gateway token empty for this public mode; never give it to a browser.
TASTETRAIL_ALLOWED_ORIGINS=
TASTETRAIL_MAX_BODY_BYTES=16384
TASTETRAIL_REQUESTS_PER_HOUR=30
TASTETRAIL_STARTUP_CHECK=1
TASTETRAIL_HOST=0.0.0.0
PORT=8773
OPENBLAS_NUM_THREADS=2
